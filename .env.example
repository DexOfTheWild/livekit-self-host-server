# Public hostname for the actual LiveKit server.
LIVEKIT_DOMAIN=livekit.example.com
LIVEKIT_WS_URL=wss://livekit.example.com

# Public hostname for the TURN server.
TURN_DOMAIN=turn.example.com
TURN_PUBLIC_IP=203.0.113.10
TURN_LISTEN_PORT=3478
TURN_TLS_PORT=5349
TURN_MIN_RELAY_PORT=49160
TURN_MAX_RELAY_PORT=49259
# This is reused for the advertised rtc.turn_servers entries in the rendered
# LiveKit config, so you only set it once locally.
TURN_SHARED_SECRET=replace-with-a-long-random-turn-shared-secret
TURN_CERT_FULLCHAIN_FILE=/etc/letsencrypt/live/turn.example.com/fullchain.pem
TURN_CERT_PRIVKEY_FILE=/etc/letsencrypt/live/turn.example.com/privkey.pem

# Operator checklist values. Keep these in sync with:
# - the rendered LiveKit config generated by docker-compose.yml from this .env
# - ../livekit-api/.env as VOIP_LIVEKIT_API_KEY / VOIP_LIVEKIT_API_SECRET / VOIP_LIVEKIT_WS_URL
LIVEKIT_API_KEY=replace-me-livekit-api-key
LIVEKIT_API_SECRET=replace-with-a-long-random-secret

# Image tags for first bring-up. Pin exact versions after initial success.
LIVEKIT_IMAGE_TAG=latest
CADDY_IMAGE_TAG=2-alpine
REDIS_IMAGE_TAG=7-alpine
TURN_IMAGE_TAG=latest
PROMETHEUS_IMAGE_TAG=v2.53.0
NODE_EXPORTER_IMAGE_TAG=v1.8.1
REDIS_EXPORTER_IMAGE_TAG=v1.62.0
